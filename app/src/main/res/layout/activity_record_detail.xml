<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/colorPrimary"
        android:titleTextColor="@color/white"
        app:title="@string/record_detail_title"
        app:navigationIcon="@drawable/ic_back" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvTime"
                style="@style/DetailLabelStyle" />

            <TextView
                android:id="@+id/tvMessageSource"
                style="@style/DetailLabelStyle" />

            <TextView
                android:id="@+id/tvMessageType"
                style="@style/DetailLabelStyle" />

            <TextView
                android:id="@+id/tvPhone"
                style="@style/DetailLabelStyle" />

            <TextView
                android:id="@+id/tvOrderNo"
                style="@style/DetailLabelStyle" />

            <TextView
                android:id="@+id/tvCardNo"
                style="@style/DetailLabelStyle" />

            <TextView
                android:id="@+id/tvMoney"
                style="@style/DetailLabelStyle" />

            <TextView
                android:id="@+id/tvStatus"
                style="@style/DetailLabelStyle" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/detail_sms_content"
                android:textStyle="bold"
                android:textColor="@color/colorTextPrimary" />

            <TextView
                android:id="@+id/tvSmsContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:padding="10dp"
                android:background="@drawable/bg_date_box"
                android:textColor="@color/colorTextPrimary" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/detail_api_result"
                android:textStyle="bold"
                android:textColor="@color/colorTextPrimary" />

            <TextView
                android:id="@+id/tvApiMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:padding="10dp"
                android:background="@drawable/bg_date_box"
                android:textColor="@color/colorTextPrimary" />

            <TextView
                android:id="@+id/tvApiRaw"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:padding="10dp"
                android:textSize="12sp"
                android:background="@drawable/bg_date_box"
                android:textColor="@color/colorTextSecondary" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
